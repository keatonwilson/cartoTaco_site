    <script>
      import gsap from 'gsap';
      import { countOpenNow } from '../lib/openNow.js';

      // Live line: how many vetted spots are open right now, Tucson time.
      // The static "Live from the Taco Census" link stays if the request fails.
      const openNow = document.getElementById('open-now');
      countOpenNow().then(({ open, total }) => {
        openNow.querySelector('[data-live-text]').innerHTML =
          `<strong class="live-num"><span data-count>${open}</span> of ${total}</strong> spots open right now &rarr;`;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          gsap.from(openNow.querySelector('[data-count]'), { textContent: 0, duration: 1.4, ease: 'power2.out', snap: { textContent: 1 } });
        }
      }).catch(() => {});
    </script>

    <!-- Dark mode toggle script -->
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function() {
        const root = document.documentElement;
        const isDark = root.classList.contains('dark');
        if (isDark) {
          root.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          root.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    </script>
