---
import '../styles/global.css';

const APP = 'https://carto-taco.vercel.app';
const CENSUS = `${APP}/census`;

const lenses = [
  ['Spots', 'The classic map. Restaurants, stands and trucks, each with its own marker.'],
  ['Heat', 'Every spot coloured by how hot its salsa runs. Darker means hotter (left).'],
  ['Salsas', 'Marker size is the salsa count. Find the places with a whole bar of them.'],
  ['Density', 'A true heatmap of where the spots cluster. South Tucson burns brightest (right).'],
];

const cardDetails = [
  ['Week rhythm hours', 'Each spot’s week as small open-hour bars, with an Open Now flag. Tap a day for the exact times.'],
  ['Salsa lineup and heat ladder', 'Every salsa rated on its own, and a heat score with city context: “hotter than 82% of Tucson spots.”'],
  ['Menu and protein shapes', 'Two radar charts show what a spot really leans on, so you can tell a birria place from an asada place at a glance.'],
  ['Vibe fingerprints', 'Four quick votes instead of reviews: heat legit, authentic, value, vibe. No stars, no essays.'],
];

const together = [
  ['Taco Trail', 'A multi-stop crawl routed for walking, biking or driving, shared as a link.'],
  ['Compare', 'Pick two or three spots. The leader in each category is called out, and their radar shapes overlay on one chart.'],
  ['Taco Summit', 'Can’t agree where to eat? Send an anonymous ranked-choice vote. Confetti for the winner.'],
  ['Surprise Me', 'One tap, one random open spot. Sometimes the map knows better than you do.'],
];

const spots = [
  ['El Antojo Poblano', 'Westside', 'A family kitchen bringing southern Mexican cooking to the Westside. The mole comes straight from Puebla, made by their mother and shipped to Tucson. Get the huaraches.'],
  ['El Chivo de Oro', 'South Side', 'A food-truck institution since 2008. Maria Elena Domínguez’s goat birria has a devoted following: quesabirria, Sonoran hot dogs and homemade tortillas on W. Irvington.'],
  ['Tacos Apson', 'South 12th Avenue', 'No frills, no menu on the wall, just carne asada and costilla tacos done exactly right. You drive past three times before you find it. Worth every wrong turn.'],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="shortcut icon" href="/no_words.png" />
    <link rel="icon" type="image/png" href="/no_words.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>CartoTaco · The taco guide that knows Tucson</title>
    <meta name="description" content="A hand-picked map of Tucson's small, local taco spots. No algorithms, no sponsored results, no star ratings." />

    <meta property="og:title" content="CartoTaco · The Tucson Taco Guide" />
    <meta property="og:description" content="No algorithms. No sponsored results. Just the spots worth knowing." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cartotaco.com" />
    <meta property="og:image" content="https://cartotaco.com/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CartoTaco · The Tucson Taco Guide" />
    <meta name="twitter:description" content="No algorithms. No sponsored results. Just the spots worth knowing." />
    <meta name="twitter:image" content="https://cartotaco.com/og-image.png" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/bold/style.css" />

    <script is:inline>
      if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>

  <body class="antialiased">

    <!-- ===== NAV ===== -->
    <header class="fixed top-0 inset-x-0 z-50 bg-bg-primary">
      <nav class="max-w-6xl mx-auto px-5 md:px-8 h-16 flex items-center justify-between gap-4" aria-label="Main">
        <a href="#" class="flex items-center gap-2.5">
          <img src="/no_words.png" alt="" class="h-9 w-9" />
          <span class="display text-[1.75rem] tracking-wide">Carto<span class="text-accent-ink">Taco</span></span>
        </a>
        <div class="flex items-center gap-5 md:gap-7 text-small font-medium">
          <a href="#map" class="hidden md:inline hover:text-accent-ink">The map</a>
          <a href="#census" class="hidden md:inline hover:text-accent-ink">Census</a>
          <a href="#honest" class="hidden md:inline hover:text-accent-ink">How it stays honest</a>
          <a href="https://instagram.com/carto_taco" target="_blank" rel="noopener noreferrer" aria-label="CartoTaco on Instagram" class="hidden sm:inline text-xl hover:text-accent-ink"><i class="ph ph-instagram-logo"></i></a>
          <a href="https://www.threads.com/@carto_taco" target="_blank" rel="noopener noreferrer" aria-label="CartoTaco on Threads" class="hidden sm:inline text-xl hover:text-accent-ink"><i class="ph ph-threads-logo"></i></a>
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="text-xl hover:text-accent-ink">
            <i class="ph ph-sun hidden dark:block"></i>
            <i class="ph ph-moon block dark:hidden"></i>
          </button>
          <a href={APP} target="_blank" rel="noopener noreferrer" class="btn !py-2 !px-4 !text-small">Open the app</a>
        </div>
      </nav>
    </header>

    <main>
      <!-- ===== HERO ===== -->
      <section class="pt-28 md:pt-36 pb-24 md:pb-36 bg-bg-primary overflow-hidden" data-section>
        <div class="max-w-6xl mx-auto px-5 md:px-8">
          <h1 class="display text-display" data-rise>The taco guide<br class="hidden sm:block" /> that knows Tucson</h1>
          <div class="mt-10 md:mt-14 grid lg:grid-cols-12 gap-10 lg:gap-8 items-start">
            <div class="lg:col-span-4">
              <p class="text-lead max-w-md" data-rise>
                A hand-picked map of Tucson’s small, local taco spots. No algorithms, no sponsored results, no star ratings.
              </p>
              <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-rise>
                <a href={APP} target="_blank" rel="noopener noreferrer" class="btn">Open the map <i class="ph-bold ph-arrow-right"></i></a>
                <a href="#census" class="link">See the Taco Census</a>
              </div>
              <p class="mt-10 text-small text-text-secondary" data-rise>
                <a id="open-now" href={CENSUS} target="_blank" rel="noopener noreferrer" class="hover:text-accent-ink">
                  See which spots are open right now, live from the census.
                </a>
              </p>
            </div>
            <figure class="lg:col-span-8 lg:-mr-[max(2rem,calc((100vw-72rem)/2+2rem))]" data-rise>
              <div class="overflow-hidden">
                <img id="hero-map" src="/shots/map-spots.jpg" width="1800" height="1025" alt="The CartoTaco map of Tucson, with clustered taco spots along South 12th Avenue and downtown" class="shot" />
              </div>
            </figure>
          </div>
        </div>
      </section>

      <!-- ===== WHY ===== -->
      <section class="py-20 md:py-40 bg-bg-secondary" data-section>
        <div class="max-w-6xl mx-auto px-5 md:px-8 grid lg:grid-cols-12 gap-10 lg:gap-8">
          <h2 class="display text-heading lg:col-span-5" data-rise>A small list, on purpose</h2>
          <div class="lg:col-span-7 space-y-6 max-w-2xl" data-rise>
            <p class="text-lead">
              Search for tacos and you get the same five places with 4.2 stars and 800 reviews. Half are chains. None are what you were looking for. The wisdom of the crowd isn’t wise. It’s just loud.
            </p>
            <p>
              CartoTaco runs on a different idea: one person who really knows a place is worth more than a thousand people who kinda liked it. Every spot here was chosen on purpose. Places that have cooked the same way for decades. Family kitchens without a website. Trucks that move. You won’t find everything, you’ll find the right things.
            </p>
          </div>
        </div>
      </section>

      <!-- ===== THE MAP: LENSES ===== -->
      <section id="map" class="py-20 md:py-40 bg-bg-primary" data-section>
        <div class="max-w-6xl mx-auto px-5 md:px-8">
          <div class="grid lg:grid-cols-12 gap-10 lg:gap-8 items-end">
            <h2 class="display text-heading lg:col-span-6" data-rise>One map, four ways to read it</h2>
            <p class="lg:col-span-6 text-lead max-w-xl" data-rise>
              The map visualises its own data. One tap switches the lens and the whole city redraws.
            </p>
          </div>
          <div class="mt-16 grid md:grid-cols-2 gap-5">
            <figure data-rise>
              <img src="/shots/map-heat.jpg" width="1800" height="1025" loading="lazy" alt="Heat lens: spots coloured from pale to deep coral by salsa heat" class="shot" />
            </figure>
            <figure data-rise>
              <img src="/shots/map-density.jpg" width="1800" height="1025" loading="lazy" alt="Density lens: a heatmap glowing over South Tucson and downtown" class="shot" />
            </figure>
          </div>
          <dl class="mt-16 grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
            {lenses.map(([name, text]) => (
              <div data-rise>
                <dt class="display text-[2.25rem]">{name}</dt>
                <dd class="mt-2 text-text-primary">{text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- ===== SPOT CARDS ===== -->
      <section class="py-20 md:py-40 bg-bg-secondary" data-section>
        <div class="max-w-6xl mx-auto px-5 md:px-8 grid lg:grid-cols-12 gap-12 lg:gap-8 items-start">
          <figure class="lg:col-span-7 lg:-ml-[max(2rem,calc((100vw-72rem)/2+2rem))] order-2 lg:order-1" data-rise>
            <img src="/shots/card.jpg" width="1800" height="1220" loading="lazy" alt="Spot card for Taqueria el Zarape: hours by day, Open Now, address, vibe check, and menu and protein radar charts" class="shot" />
          </figure>
          <div class="lg:col-span-5 order-1 lg:order-2">
            <h2 class="display text-heading" data-rise>Every spot, in detail</h2>
            <p class="mt-6 text-lead" data-rise>Tap a marker and the card tells you what you need before you drive across town.</p>
            <dl class="mt-12 space-y-8">
              {cardDetails.map(([name, text]) => (
                <div data-rise>
                  <dt class="font-semibold text-lead">{name}</dt>
                  <dd class="mt-1">{text}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>

      <!-- ===== CENSUS ===== -->
      <section id="census" class="py-20 md:py-40 bg-bg-ink text-on-ink" data-section>
        <div class="max-w-6xl mx-auto px-5 md:px-8">
          <div class="grid lg:grid-cols-12 gap-10 lg:gap-8 items-end">
            <h2 class="display text-heading lg:col-span-7" data-rise>The Tucson Taco Census</h2>
            <p class="lg:col-span-5 text-lead text-on-ink-muted" data-rise>
              Everything the map knows, on one shareable page, computed live from every vetted spot.
            </p>
          </div>
          <div class="mt-16 grid lg:grid-cols-12 gap-5">
            <figure class="lg:col-span-5" data-rise>
              <img src="/shots/census-stats.jpg" width="1800" height="958" loading="lazy" alt="Census headline numbers: 24 spots on the map, 18 open right now, average heat 5.3 out of 10, 88 salsas citywide" class="shot" />
            </figure>
            <figure class="lg:col-span-7" data-rise>
              <img src="/shots/census-when.jpg" width="1190" height="460" loading="lazy" alt="When can you get a taco: a day-by-hour grid, darkest from late morning to early evening, Wednesday to Saturday" class="shot" />
            </figure>
          </div>
          <div class="mt-16 grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
            <figure class="lg:col-span-7" data-rise>
              <img src="/shots/census-growth.jpg" width="1190" height="598" loading="lazy" alt="The map keeps growing: spots on the map from March to October, stepping up to 24 with one step down for a closure" class="shot" />
            </figure>
            <div class="lg:col-span-5 space-y-6" data-rise>
              <p class="text-lead">The growth chart counts closures too.</p>
              <p class="text-on-ink-muted">
                When a spot closes, the line steps down from that day on. Earlier months keep the count they really had, so a closure never quietly rewrites the past.
              </p>
              <a href={CENSUS} target="_blank" rel="noopener noreferrer" class="btn">Explore the census <i class="ph-bold ph-arrow-right"></i></a>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== HONEST MAP ===== -->
      <section id="honest" class="py-20 md:py-40 bg-bg-primary" data-section>
        <div class="max-w-6xl mx-auto px-5 md:px-8 grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          <div class="lg:col-span-7">
            <h2 class="display text-heading" data-rise>Nothing gets quietly deleted</h2>
            <p class="mt-6 text-lead max-w-xl" data-rise>
              A curated map is only worth trusting if it tells you what it doesn’t know.
            </p>
            <dl class="mt-12 grid sm:grid-cols-2 gap-x-8 gap-y-10">
              <div data-rise>
                <dt class="font-semibold text-lead">Closed spots stay marked</dt>
                <dd class="mt-1">A spot that closes for good turns into a grey cross on the map and says so on its card. It drops out of stats, recommendations and trails.</dd>
              </div>
              <div data-rise>
                <dt class="font-semibold text-lead">Scouted isn’t vetted</dt>
                <dd class="mt-1">Spots waiting for a visit show as grey question marks with a preliminary card. They’re never counted until they’ve been checked.</dd>
              </div>
              <div data-rise>
                <dt class="font-semibold text-lead">Still no star ratings</dt>
                <dd class="mt-1">No stars, no rankings, no paid placement. A spot is on the map because it earned it.</dd>
              </div>
              <div data-rise>
                <dt class="font-semibold text-lead">Tucson to Green Valley</dt>
                <dd class="mt-1">The map now reaches south to Green Valley, so the drive down I-19 counts.</dd>
              </div>
            </dl>
          </div>
          <figure class="lg:col-span-5 max-w-sm mx-auto lg:max-w-none w-full" data-rise>
            <img src="/shots/phone-map.jpg" width="647" height="1400" loading="lazy" alt="CartoTaco on a phone: clustered spots in central Tucson, grey question-mark markers for scouted spots, and a legend for vetted, pending and closed" class="shot" />
          </figure>
        </div>
      </section>

      <!-- ===== TOGETHER ===== -->
      <section class="py-20 md:py-40 bg-accent text-[#111418]" data-section>
        <div class="max-w-6xl mx-auto px-5 md:px-8 grid lg:grid-cols-12 gap-10 lg:gap-8">
          <h2 class="display text-heading lg:col-span-5" data-rise>Built for the group chat</h2>
          <dl class="lg:col-span-7 grid sm:grid-cols-2 gap-x-8 gap-y-10">
            {together.map(([name, text]) => (
              <div data-rise>
                <dt class="display text-[2.25rem]">{name}</dt>
                <dd class="mt-2">{text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- ===== THE LIST ===== -->
      <section class="py-20 md:py-40 bg-bg-secondary" data-section>
        <div class="max-w-6xl mx-auto px-5 md:px-8">
          <h2 class="display text-heading" data-rise>A taste of what’s inside</h2>
          <div class="mt-16 grid md:grid-cols-3 gap-x-8 gap-y-14">
            {spots.map(([name, area, text]) => (
              <article data-rise>
                <h3 class="display text-[2.5rem]">{name}</h3>
                <p class="mt-1 font-semibold">{area}</p>
                <p class="mt-4">{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ===== ABOUT + ACCOUNTS ===== -->
      <section class="py-20 md:py-40 bg-bg-primary" data-section>
        <div class="max-w-6xl mx-auto px-5 md:px-8 grid lg:grid-cols-12 gap-16 lg:gap-8">
          <div class="lg:col-span-6">
            <h2 class="display text-heading" data-rise>Why I made this</h2>
            <div class="mt-8 space-y-5 max-w-xl" data-rise>
              <p>
                The best food in Tucson doesn’t show up on the first page of a search engine. It’s in places with no marketing budget, that have never asked anyone for a review, that have served the same recipes for generations.
              </p>
              <p>
                I’m a data nerd, and I wanted a guide I could hand to a friend: no stars, no rankings, no algorithm deciding what you eat. Just a short list of spots I’d stake my reputation on. It’s a one-person project, and that’s the point. Curation means someone is making choices.
              </p>
            </div>
          </div>
          <div class="lg:col-span-6">
            <h2 class="display text-heading" data-rise>Better with a login</h2>
            <p class="mt-8 max-w-xl" data-rise>Still free, no credit card. The map works fine without an account, but your tacos get personal with one.</p>
            <dl class="mt-10 space-y-7 max-w-xl">
              <div data-rise>
                <dt class="font-semibold text-lead">Favorites</dt>
                <dd class="mt-1">Save your go-to spots, synced across devices, and filter the map to only what you love.</dd>
              </div>
              <div data-rise>
                <dt class="font-semibold text-lead">Taste profile</dt>
                <dd class="mt-1">Your taco archetype, from Heat Seeker to The Purist, built from what you actually favorite.</dd>
              </div>
              <div data-rise>
                <dt class="font-semibold text-lead">On the way</dt>
                <dd class="mt-1">Check-ins and a taco passport, and real taco meetups pinned to the map.</dd>
              </div>
            </dl>
            <div class="mt-10" data-rise>
              <a href={APP} target="_blank" rel="noopener noreferrer" class="btn">Create a free account <i class="ph-bold ph-arrow-right"></i></a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="pt-20 md:pt-40 pb-10 bg-bg-ink text-on-ink overflow-hidden" data-section>
      <div class="max-w-6xl mx-auto px-5 md:px-8">
        <h2 class="display text-heading" data-rise>Ready to eat well?</h2>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-rise>
          <a href={APP} target="_blank" rel="noopener noreferrer" class="btn">Open CartoTaco <i class="ph-bold ph-arrow-right"></i></a>
          <span class="text-on-ink-muted">Free. No account needed.</span>
        </div>
        <p class="display mt-16 md:mt-32 text-[clamp(4.5rem,21vw,19rem)] leading-[0.8]" aria-hidden="true" data-wordmark>Carto<span class="text-accent">Taco</span></p>
        <div class="mt-10 flex flex-wrap items-center justify-between gap-6 text-small text-on-ink-muted">
          <div class="flex items-center gap-6">
            <a href="mailto:info@cartotaco.com" class="hover:text-on-ink">info@cartotaco.com</a>
            <a href="https://instagram.com/carto_taco" target="_blank" rel="noopener noreferrer" aria-label="CartoTaco on Instagram" class="text-xl hover:text-on-ink"><i class="ph ph-instagram-logo"></i></a>
            <a href="https://www.threads.com/@carto_taco" target="_blank" rel="noopener noreferrer" aria-label="CartoTaco on Threads" class="text-xl hover:text-on-ink"><i class="ph ph-threads-logo"></i></a>
          </div>
          <span>&copy; {new Date().getFullYear()} CartoTaco</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });
    </script>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { countOpenNow } from '../lib/openNow.js';

      gsap.registerPlugin(ScrollTrigger);

      // Live line: how many vetted spots are open right now, Tucson time.
      // The static link to the census stays if the request fails.
      const openNow = document.getElementById('open-now');
      countOpenNow().then(({ open, total }) => {
        openNow.innerHTML = `Right now in Tucson, <strong class="font-semibold text-text-primary"><span data-count>${open}</span> of ${total}</strong> spots are open. See the census&nbsp;→`;
        const n = openNow.querySelector('[data-count]');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          gsap.from(n, { textContent: 0, duration: 1.2, ease: 'power2.out', snap: { textContent: 1 } });
        }
      }).catch(() => {});

      const mm = gsap.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        // Each section's parts rise in turn: heading, text, then picture.
        gsap.utils.toArray('[data-section]').forEach((section) => {
          const parts = section.querySelectorAll('[data-rise]');
          if (!parts.length) return;
          gsap.from(parts, {
            y: 28,
            autoAlpha: 0,
            duration: 0.8,
            ease: 'power3.out',
            stagger: 0.08,
            scrollTrigger: { trigger: section, start: 'top 90%', once: true },
          });
        });

        // Signature move: the hero map settles in as you scroll past it.
        gsap.fromTo('#hero-map', { scale: 1.12 }, {
          scale: 1,
          yPercent: 4,
          ease: 'none',
          scrollTrigger: { trigger: '#hero-map', start: 'top 80%', end: 'bottom top', scrub: true },
        });

        // The footer wordmark rises in under the scroll.
        gsap.from('[data-wordmark]', {
          y: 80,
          ease: 'none',
          scrollTrigger: { trigger: '[data-wordmark]', start: 'top bottom', end: 'bottom bottom', scrub: true },
        });
      });

      // Screenshots load lazily; recompute trigger positions once they have.
      window.addEventListener('load', () => ScrollTrigger.refresh());
    </script>
  </body>
</html>
